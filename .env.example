# Copy to .env and change every value before any hosted use.
# Never commit .env. These defaults are for local synthetic-data demos only.

# PostgreSQL (one server, separate database + credentials per owner)
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
CENTRAL_DB_PASSWORD=change-me-central
DRALI_DB_PASSWORD=change-me-drali
CHUGHTAI_DB_PASSWORD=change-me-chughtai
ZIAUDDIN_DB_PASSWORD=change-me-ziauddin
AKUH_DB_PASSWORD=change-me-akuh
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
# Password given to every seeded synthetic demo account
DEMO_USER_PASSWORD=demo1234
# Confidential client secrets (each service validates/introspects its own tokens)
CENTRAL_CLIENT_SECRET=change-me-central-secret
DRALI_CLIENT_SECRET=change-me-drali-secret
CHUGHTAI_CLIENT_SECRET=change-me-chughtai-secret
ZIAUDDIN_CLIENT_SECRET=change-me-ziauddin-secret
AKUH_CLIENT_SECRET=change-me-akuh-secret

# Language model (optional; used only to read uploaded papers).
# Leave ANTHROPIC_API_KEY empty to use the rule-based reader instead.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Open models through Ollama instead:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=gemma4:cloud   (free plan; run `ollama signin` on the computer running Ollama)
#   OLLAMA_HOST=http://host.docker.internal:11434   (Ollama on this computer, as seen from the containers)
# or call Ollama's cloud directly: OLLAMA_HOST=https://ollama.com, OLLAMA_API_KEY=<key from
# https://ollama.com/settings/keys>, and the model's API name (e.g. gemma4:31b) as LLM_MODEL.
OLLAMA_HOST=
OLLAMA_API_KEY=
# Privacy: patient data (always de-identified first) may go to a model outside this computer (a ":cloud"
# model, ollama.com, Anthropic) only when this is true. Synthetic data only until the operating institution
# has agreed (docs/decisions/2026-10-28-cloud-model-privacy.md). Remote servers must use https.
LLM_EXTERNAL_ALLOWED=false
LLM_TIMEOUT_SECONDS=120
# Extraction: "llm" uses the language model when configured, otherwise "rules"
EXTRACTION_MODE=auto

# Reading uploaded papers. "tesseract" reads printed text on this computer. "google_vision" also reads
# handwriting (doctors' prescriptions) with Google Cloud Vision: the page image is sent to Google.
# Key: Google Cloud console > APIs & Services > Credentials > API key, restricted to the Cloud Vision API.
# Synthetic data only until the operating institution has agreed to this (docs/decisions/2026-10-28-handwriting-ocr.md).
OCR_ENGINE=tesseract
GOOGLE_VISION_API_KEY=

# Retention (days) for uploaded document copies after referral closure
DOCUMENT_RETENTION_DAYS=365
