# Copy to .env and change every value before any hosted use.
# Never commit .env. These defaults are for local synthetic-data demos only.

# PostgreSQL (one server, separate database + credentials per owner)
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
CENTRAL_DB_PASSWORD=change-me-central
CLINIC_DB_PASSWORD=change-me-clinic
LAB_DB_PASSWORD=change-me-lab
SPECIALIST_DB_PASSWORD=change-me-specialist
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
# Password given to every seeded synthetic demo account
DEMO_USER_PASSWORD=demo1234
# Confidential client secrets (each service validates/introspects its own tokens)
CENTRAL_CLIENT_SECRET=change-me-central-secret
CLINIC_CLIENT_SECRET=change-me-clinic-secret
LAB_CLIENT_SECRET=change-me-lab-secret
SPECIALIST_CLIENT_SECRET=change-me-specialist-secret

# Language model (brief generation + structured extraction).
# Leave ANTHROPIC_API_KEY empty to run without a model: generation then fails
# visibly and the manual editor / rule-based extractor remain available (FR-58).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Extraction: "llm" uses the language model when configured, otherwise "rules"
EXTRACTION_MODE=auto

# Retention (days) for uploaded document copies after referral closure
DOCUMENT_RETENTION_DAYS=365
