{
  "realm": "referral",
  "displayName": "Referral Platform (synthetic demo)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "clinician",
        "description": "Doctor: requests referrals, acknowledges medication flags, receives referrals for their department"
      },
      {
        "name": "clinic_staff",
        "description": "Staff: patient links, records, papers and medicines; sends referrals; follow-up"
      },
      {
        "name": "diagnostics_staff",
        "description": "Laboratory, imaging or ECG staff: test and scan orders"
      },
      {
        "name": "institution_admin",
        "description": "Institution administrator (accounts, source access, audit; no clinical access)"
      },
      {
        "name": "rule_reviewer",
        "description": "Clinical reviewer who approves medication rules and medicine names"
      },
      {
        "name": "patient",
        "description": "Patient: sees their own referrals and reads their own records from each institution"
      },
      {
        "name": "svc_central",
        "description": "Central platform service identity"
      },
      {
        "name": "svc_provider",
        "description": "Institution service identity"
      }
    ]
  },
  "groups": [
    {
      "name": "drali",
      "subGroups": [
        {
          "name": "general_practice"
        },
        {
          "name": "clinic_tests"
        }
      ]
    },
    {
      "name": "ziauddin",
      "subGroups": [
        {
          "name": "cardiology"
        },
        {
          "name": "gastro_hepatology"
        },
        {
          "name": "radiology"
        },
        {
          "name": "cardiac_diagnostics"
        },
        {
          "name": "laboratory"
        }
      ]
    },
    {
      "name": "akuh",
      "subGroups": [
        {
          "name": "dentistry"
        },
        {
          "name": "orthopaedics"
        },
        {
          "name": "general_surgery"
        },
        {
          "name": "radiology"
        },
        {
          "name": "laboratory"
        }
      ]
    },
    {
      "name": "chughtai",
      "subGroups": [
        {
          "name": "laboratory"
        },
        {
          "name": "radiology"
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"cnic\", \"displayName\": \"CNIC\", \"validations\": {\"length\": {\"min\": 13, \"max\": 15}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "referral-web",
      "name": "Referral web application",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "${WEB_ORIGIN}/*"
      ],
      "webOrigins": [
        "${WEB_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_ORIGIN}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
