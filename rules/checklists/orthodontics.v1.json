{
  "checklist_id": "orthodontics-referral-checklist",
  "version": "1.0.0",
  "specialty": "orthodontics",
  "governance": "Assesses referral completeness against agreed requirements only. It does not prescribe investigations. Items marked override_allowed may be closed by a clinician with a recorded rationale; others block submission until present.",
  "items": [
    {"id": "CL-REASON", "check": "reason_present", "title": "Referral reason documented", "blocking": true, "override_allowed": false, "clinical": false},
    {"id": "CL-PRIORITY", "check": "priority_selected", "title": "Clinician-selected priority recorded", "blocking": true, "override_allowed": false, "clinical": true},
    {"id": "CL-PROCEDURE", "check": "procedure_stated", "title": "Planned procedure stated, or explicitly recorded as unknown", "blocking": true, "override_allowed": false, "clinical": true},
    {"id": "CL-CLINICIAN", "check": "clinician_assigned", "title": "Referring clinician assigned", "blocking": true, "override_allowed": false, "clinical": false},
    {"id": "CL-HISTORY", "check": "history_present", "title": "Relevant documented medical history included", "blocking": true, "override_allowed": true, "clinical": true},
    {"id": "CL-MEDS-VERIFIED", "check": "medications_verified", "title": "Current medication use verified by a clinician", "blocking": true, "override_allowed": true, "clinical": true},
    {"id": "CL-MED-SOURCES", "check": "medication_sources_complete", "title": "Medication sources retrieved successfully", "blocking": false, "override_allowed": true, "clinical": false},
    {"id": "CL-SOURCES", "check": "sources_available", "title": "Linked source systems retrieved", "blocking": false, "override_allowed": true, "clinical": false},
    {"id": "CL-DOC-FIELDS", "check": "document_fields_resolved", "title": "Selected document-extracted fields verified or resolved", "blocking": true, "override_allowed": true, "clinical": true},
    {"id": "CL-DISCREPANCY", "check": "discrepancies", "title": "Supported discrepancies reviewed by a clinician", "blocking": true, "override_allowed": true, "clinical": true}
  ],
  "discrepancy_types": [
    {"id": "D-MED-DOSE", "description": "Same verified ingredient recorded with different dose instructions by different current records"},
    {"id": "D-LAB-SAME-TIME", "description": "Same laboratory test with the same collection date but different values"}
  ]
}
